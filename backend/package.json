{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "LearnSphere LMS - REST API, BullMQ/FFmpeg worker, LiveKit + Socket.IO realtime",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/videoWorker.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --forceExit",
    "lint": "node --check src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/cloudfront-signer": "^3.1166.0",
    "@aws-sdk/lib-storage": "^3.1168.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.3",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 90000,
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}