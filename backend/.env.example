# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000          # public URL of this API (used in media/thumbnail URLs)
CLIENT_URL=http://localhost:5173            # frontend origin(s), comma separated (CORS + certificate QR links)

# ---------- Database & queue ----------
MONGO_URI=mongodb://127.0.0.1:27017/learnsphere
REDIS_URL=redis://127.0.0.1:6379

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production (openssl rand -hex 48)
JWT_EXPIRES_IN=7d
MEDIA_TOKEN_TTL_SEC=14400

# ---------- Storage (video + thumbnails) ----------
STORAGE_DRIVER=local                        # local | s3
LOCAL_STORAGE_DIR=./storage
TMP_DIR=./tmp
MAX_VIDEO_SIZE_MB=500

# ---------- Video processing (BullMQ + FFmpeg) ----------
VIDEO_JOB_ATTEMPTS=3
VIDEO_JOB_BACKOFF_MS=5000
VIDEO_WORKER_CONCURRENCY=1
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe      # only if ffmpeg is not on PATH
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# ---------- AWS S3 + CloudFront (optional; needed only when STORAGE_DRIVER=s3) ----------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=                          # e.g. d111111abcdef8.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=                     # CloudFront public key ID
CLOUDFRONT_PRIVATE_KEY=                     # PEM private key; use \n for new lines
CLOUDFRONT_URL_TTL_SEC=14400

# ---------- LiveKit (live classes) ----------
LIVEKIT_URL=ws://localhost:7880             # URL the BROWSER connects to
LIVEKIT_API_URL=                            # URL the BACKEND uses (defaults to LIVEKIT_URL as http); in Docker: http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_STUDENTS_CAN_PUBLISH=true

# ---------- Payments (Razorpay TEST mode) ----------
# Leave empty to use the built-in SIMULATED test gateway (clearly labelled in the UI).
RAZORPAY_KEY_ID=                            # rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_SIMULATED_PAYMENTS=true               # forced off by default in production
PLATFORM_FEE_PERCENT=20

# ---------- Logging ----------
LOG_LEVEL=info
