# Root .env used by docker-compose.yml  (copy to .env and edit)
JWT_SECRET=change-me-to-a-long-random-string
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-secret-secret-secret-secret-1234   # LiveKit requires >= 32 characters

# Public URLs as seen from the BROWSER
API_PUBLIC_URL=http://localhost:5000
CLIENT_PUBLIC_URL=http://localhost:5173
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Optional: real Razorpay TEST keys (empty = simulated gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: S3 + CloudFront delivery (see docs/SETUP.md). Leave STORAGE_DRIVER=local for development.
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
