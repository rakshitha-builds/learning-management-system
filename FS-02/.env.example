# ---------------------------------------------------------------------------
# Copy to .env (or run `npm run setup:env` to generate it with random secrets).
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
# Used by docker-compose.yml to create the local database container.
POSTGRES_USER=collab
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=collab_workspace
POSTGRES_PORT=5432
# Prisma / backend connection string (keep in sync with the values above).
DATABASE_URL=postgresql://collab:change-me-db-password@localhost:5432/collab_workspace?schema=public

# --- Redis (optional locally - the backend falls back to single-instance mode if empty) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend ---
BACKEND_PORT=4000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin(s) allowed by CORS / WebSocket origin check (comma separated)
FRONTEND_ORIGIN=http://localhost:3000
# Set to true when serving over HTTPS
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Automatic version snapshot interval (minutes) while a document is being edited
AUTO_SNAPSHOT_MINUTES=10

# --- Frontend (Next.js) ---
# Where the Next.js server proxies /api and /uploads to
BACKEND_URL=http://localhost:4000
# WebSocket endpoint used by the browser for real-time collaboration
NEXT_PUBLIC_WS_URL=ws://localhost:4000
