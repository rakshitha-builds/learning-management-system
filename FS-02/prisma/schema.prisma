// Prisma schema - Real-Time Collaborative Workspace
// The datasource URL is configured in backend/prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  color        String   @default("#6366f1")
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces Workspace[]          @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  invitesSent     WorkspaceInvite[]
  documents       Document[]
  comments        Comment[]
  versions        DocumentVersion[]
  permissions     DocumentPermission[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("🗂️")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  documents Document[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(EDITOR)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        Role     @default(EDITOR)
  invitedById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
}

model Document {
  id           String   @id @default(cuid())
  workspaceId  String
  title        String   @default("Untitled")
  icon         String   @default("📄")
  createdById  String
  /// Compacted Yjs state (merge of all updates up to the last compaction)
  ydocState    Bytes?
  /// Incremented on every compaction (optimistic concurrency across server instances)
  stateVersion Int      @default(0)
  /// Plain-text projection of the document (previews / version excerpts)
  plainText    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  updates     DocumentUpdate[]
  comments    Comment[]
  versions    DocumentVersion[]
  permissions DocumentPermission[]

  @@index([workspaceId, updatedAt])
}

/// Incremental Yjs updates appended by the collaboration server.
model DocumentUpdate {
  id         Int      @id @default(autoincrement())
  documentId String
  data       Bytes
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, id])
}

/// Per-document role override for a specific user (takes precedence over the workspace role).
model DocumentPermission {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  role       Role
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  parentId   String?
  body       String
  /// Text the comment refers to (selection when the comment was written)
  quote      String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([documentId, createdAt])
  @@index([parentId])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  label       String?
  title       String
  /// Full Yjs state at snapshot time
  snapshot    Bytes
  plainText   String   @default("")
  auto        Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
}
